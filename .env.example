# ===================================
# Korean Food Agent 환경 변수
# ===================================

# ===========================
# LLM 설정 (필수)
# ===========================

# Google AI API Key (Gemini) - 필수
# https://aistudio.google.com/app/apikey 에서 발급
GOOGLE_API_KEY=your-google-api-key-here

# OpenAI API Key (선택사항, Gemini만 써도 됨)
OPENAI_API_KEY=your-openai-api-key-here

# 사용할 모델 제공자 (gemini, openai, vllm, local)
MODEL_PROVIDER=gemini

# 사용할 모델 이름
OPENAI_MODEL=gpt-4o
GEMINI_MODEL=gemini-2.0-flash

# ===========================
# 검색 API (필수)
# ===========================

# Serper.dev API Key (이미지 검색 + 텍스트 검색)
# https://serper.dev/ 에서 발급 (무료 2,500회/월)
SERPER_API_KEY=your-serper-api-key-here

# 카카오 REST API Key (식당 검색용)
# https://developers.kakao.com/ 에서 발급
KAKAO_API_KEY=your-kakao-rest-api-key-here

# ===========================
# 쇼핑 API (선택)
# ===========================

# 네이버 개발자 센터 (쇼핑 검색)
# https://developers.naver.com/ 에서 발급
NAVER_CLIENT_ID=your-naver-client-id-here
NAVER_CLIENT_SECRET=your-naver-client-secret-here

# 쿠팡 파트너스 (제휴 상품)
# https://partners.coupang.com/ 에서 발급
COUPANG_ACCESS_KEY=your-coupang-access-key-here
COUPANG_SECRET_KEY=your-coupang-secret-key-here

# ===========================
# 프론트엔드 (필수)
# ===========================

# 카카오맵 JavaScript 키
NEXT_PUBLIC_KAKAO_JS_KEY=your-kakao-js-key-here

# 백엔드 API URL
NEXT_PUBLIC_API_URL=http://localhost:8000
